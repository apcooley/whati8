# whati8 Environment Configuration
# Copy to .env.prod or .env.dev and fill in values

# Required
DATABASE_URL=postgresql://whati8:CHANGE_ME@localhost:5432/whati8
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING

# Environment: dev, staging, prod
ENVIRONMENT=dev

# Optional
DB_PASSWORD=whati8
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ANTHROPIC_API_KEY=sk-ant-...
USDA_API_KEY=...

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=5

# Token Expiry
JWT_EXPIRATION_HOURS=1
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Body Size Limit (bytes, default 1MB)
MAX_BODY_SIZE=1048576
