# whati8 — Caddy reverse proxy configuration
#
# INTERNAL / TESTING MODE (self-signed TLS)
# When a domain is ready, replace the site address with:
#   whati8.example.com {
# Caddy will auto-provision Let's Encrypt certificates.
#
# Usage:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl restart caddy

# Global options
{
	# Use internal (self-signed) certificates for IP addresses
	# Remove this block when switching to a real domain
	local_certs

	# Bind HTTPS to LAN IP only (Tailscale uses :443 on its own interface)
	default_bind 192.168.1.11
}

https://192.168.1.11 {
	# TLS with internal/self-signed cert (auto-provisioned by Caddy)
	tls internal

	# Security headers (defense in depth — whati8 also sets these)
	header {
		# HSTS — tell browsers to always use HTTPS
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Prevent clickjacking
		X-Frame-Options "DENY"
		# Prevent MIME sniffing
		X-Content-Type-Options "nosniff"
		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove Caddy server header
		-Server
	}

	# Reverse proxy to whati8 backend
	reverse_proxy localhost:9428 {
		# Pass real client IP to backend for rate limiting
		header_up X-Real-IP {remote_host}

		# Health check — Caddy will stop routing if backend is down
		health_uri /health
		health_interval 30s
		health_timeout 5s
	}

	# Request size limit (match backend's 1MB limit)
	request_body {
		max_size 1MB
	}

	# Access logging
	log {
		output file /var/log/caddy/whati8-access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# HTTP → HTTPS redirect
http://192.168.1.11 {
	redir https://192.168.1.11{uri} permanent
}
